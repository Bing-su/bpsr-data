---
import DataExplorer from "../components/DataExplorer.svelte";
import { dataFiles } from "../data-files";
import "../styles/global.css";

const files = dataFiles.map((file) => {
  const [language, , filename] = file.split("/");
  return { language, table: filename.slice(0, -".json".length) };
});
const base = import.meta.env.BASE_URL;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="icon" href={`${base}favicon.ico`} />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>BPSR Data</title>
  </head>
  <body class="min-h-screen bg-base-200 text-base-content">
    <DataExplorer client:load {files} {base} />
  </body>
</html>
