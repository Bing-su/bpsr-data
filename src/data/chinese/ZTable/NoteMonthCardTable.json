  },
  "9070009": {
    "DictionaryDes": "荷花三百里，草木正葱茏，人间七月，与美好重逢。",
    "Episode": 9070009,
    "Id": 9070009,
    "IsHide": false,
    "ListResources": "ui/textures/handbook_month_card/monthly_reward_card_main_card_10",
