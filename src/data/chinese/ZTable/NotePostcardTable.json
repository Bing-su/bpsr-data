    "Resources": "ui/textures/handbook_postcard/notepostcard_image_adldxsd"
  },
  "1210007": {
    "DictionaryDes": "明斯特霍恩曾经是个祥和的小村庄，在独立战争时被战火摧毁。战后幸存的村民回到了这里重建家园……",
    "Episode": 1210007,
    "Id": 1210007,
    "IsHide": false,
    "ListResources": "ui/textures/handbook_postcard/list_icons_notepostcard_msthe",
    "Name": "明斯特霍恩明信片",
    "Resources": "ui/textures/handbook_postcard/notepostcard_image_msthe"
  },
  "1210008": {
    "DictionaryDes": "卡尼曼部落以狩猎和采集为生，过着朴素和善的生活。他们崇拜自己的祖先，并称呼其为祖灵……",
    "Episode": 1210008,
    "Id": 1210008,
    "IsHide": false,
    "ListResources": "ui/textures/handbook_postcard/list_icons_notepostcard_knmblrk",
    "Name": "卡尼曼部落入口明信片",
    "Resources": "ui/textures/handbook_postcard/notepostcard_image_knmblrk"
  },
  "1210009": {
    "DictionaryDes": "卡尼曼部落的酋长和长老们开会议事的场所，盘绕在一棵特殊的长生树上……",
    "Episode": 1210009,
    "Id": 1210009,
    "IsHide": false,
    "ListResources": "ui/textures/handbook_postcard/list_icons_notepostcard_zlyst",
    "Name": "长老议事厅明信片",
    "Resources": "ui/textures/handbook_postcard/notepostcard_image_zlyst"
  },
  "1210010": {
    "DictionaryDes": "安德拉曾是布法利亚文明的大型都市，后因战乱而湮灭，仅存废墟至今……",
    "Episode": 1210010,
    "Id": 1210010,
    "IsHide": false,
    "ListResources": "ui/textures/handbook_postcard/list_icons_notepostcard_adlfd",
    "Name": "安德拉废都明信片",
    "Resources": "ui/textures/handbook_postcard/notepostcard_image_adlfd"
  },
  "1210011": {
    "DictionaryDes": "以击败阿斯特里斯为目的活动的黯影军团，在安德拉废都内建立的秘密藏身之处……",
    "Episode": 1210011,
    "Id": 1210011,
    "IsHide": false,
    "ListResources": "ui/textures/handbook_postcard/list_icons_notepostcard_image_aybl",
    "Name": "黯影堡垒明信片",
    "Resources": "ui/textures/handbook_postcard/notepostcard_image_aybl"
  },
  "1210012": {
    "DictionaryDes": "透过你的眼睛，我又重新拾起了童年。——莎夏",
    "Episode": 1210012,
    "Id": 1210012,
    "IsHide": false,
    "ListResources": "ui/textures/handbook_postcard/list_icons_notepostcard_gaoyuanxice",
    "Name": "俯瞰陷落河",
    "Resources": "ui/textures/handbook_postcard/notepostcard_image_gaoyuanxice"
  },
  "1210013": {
    "DictionaryDes": "小鸟的鸣叫是星星的歌声。——莎夏",
    "Episode": 1210013,
    "Id": 1210013,
    "IsHide": false,
    "ListResources": "ui/textures/handbook_postcard/list_icons_notepostcard_gaoyuanpubu",
    "Name": "落雷瀑布",
    "Resources": "ui/textures/handbook_postcard/notepostcard_image_gaoyuanpubu"
  },
  "1210014": {
    "DictionaryDes": "若世间真有造物主，必凌驾于神族与自然二者之上。——朱利安",
    "Episode": 1210014,
    "Id": 1210014,
    "IsHide": false,
    "ListResources": "ui/textures/handbook_postcard/list_icons_notepostcard_gaoyuanjushi",
    "Name": "撼天针岩",
    "Resources": "ui/textures/handbook_postcard/notepostcard_image_gaoyuanjushi"
  },
  "1210015": {
    "DictionaryDes": "这里…曾经是我的家。崖壁上布满开凿的居所，像蜂巢。——莎夏",
    "Episode": 1210015,
    "Id": 1210015,
    "IsHide": false,
    "ListResources": "ui/textures/handbook_postcard/list_icons_notepostcard_gaoyuanhedibu",
    "Name": "故居",
    "Resources": "ui/textures/handbook_postcard/notepostcard_image_gaoyuanhedibu"
  },
  "1210016": {
    "DictionaryDes": "人类的刻痕与布法利亚神族的遗迹，在此地共生。——利亚姆",
    "Episode": 1210016,
    "Id": 1210016,
    "IsHide": false,
    "ListResources": "ui/textures/handbook_postcard/list_icons_notepostcard_gaoyuanshouling",
    "Name": "陷落河石室",
    "Resources": "ui/textures/handbook_postcard/notepostcard_image_gaoyuanshouling"
  },
  "1210017": {
    "DictionaryDes": "我的布法利亚啊！核心是晶体，却有着花一样的外型！——利亚姆",
    "Episode": 1210017,
    "Id": 1210017,
    "IsHide": false,
    "ListResources": "ui/textures/handbook_postcard/list_icons_notepostcard_gaoyuanhedihuanhuanhua",
    "Name": "倒悬的幻幻花",
    "Resources": "ui/textures/handbook_postcard/notepostcard_image_gaoyuanhedihuanhuanhua"
  },
  "1210018": {
    "DictionaryDes": "这些石头就像是……一夜之间从石缝钻出来的。——莎夏",
    "Episode": 1210018,
    "Id": 1210018,
    "IsHide": false,
    "ListResources": "ui/textures/handbook_postcard/list_icons_notepostcard_gaoyuanhedi",
    "Name": "石缝中绽开的岩石",
    "Resources": "ui/textures/handbook_postcard/notepostcard_image_gaoyuanhedi"
  },
  "1210019": {
    "DictionaryDes": "有一股好闻的味道，像是快下雨时，那种干干的石头味。——艾丽达",
    "Episode": 1210019,
    "Id": 1210019,
    "IsHide": false,
    "ListResources": "ui/textures/handbook_postcard/list_icons_notepostcard_cunzhuangquanjing",
    "Name": "拉尔帕尔村",
    "Resources": "ui/textures/handbook_postcard/notepostcard_image_cunzhuangquanjing"
  },
  "1210020": {
    "DictionaryDes": "长长方方的，钻石般闪耀的神殿。那是爸爸工作的地方。——艾丽达",
    "Episode": 1210020,
    "Id": 1210020,
    "IsHide": false,
    "ListResources": "ui/textures/handbook_postcard/list_icons_notepostcard_yuzhujiaoxia",
    "Name": "神悬御柱",
    "Resources": "ui/textures/handbook_postcard/notepostcard_image_yuzhujiaoxia"
  },
  "1210021": {
    "DictionaryDes": "逃出来那天，我就站在这发誓。今后，我只为自己而活！！——欧文",
    "Episode": 1210021,
    "Id": 1210021,
    "IsHide": false,
    "ListResources": "ui/textures/handbook_postcard/list_icons_notepostcard_kuangchangfushi",
    "Name": "矿场吊塔",
    "Resources": "ui/textures/handbook_postcard/notepostcard_image_kuangchangfushi"
  },
  "1210022": {
    "DictionaryDes": "这曾是我们溜号做梦的地方。如今，只剩我这醉鬼还记得。——欧文",
    "Episode": 1210022,
    "Id": 1210022,
    "IsHide": false,
    "ListResources": "ui/textures/handbook_postcard/list_icons_notepostcard_kuangchangziran",
    "Name": "遗忘花甸",
    "Resources": "ui/textures/handbook_postcard/notepostcard_image_kuangchangziran"
  },
  "1210023": {
    "DictionaryDes": "沃尔特、凯、西尔维斯特、芬恩……他们永远留在了下面。——欧文",
    "Episode": 1210023,
    "Id": 1210023,
    "IsHide": false,
    "ListResources": "ui/textures/handbook_postcard/list_icons_notepostcard_kuagnchang",
    "Name": "矿场隘口",
    "Resources": "ui/textures/handbook_postcard/notepostcard_image_kuagnchang"
  },
  "1210024": {
    "DictionaryDes": "风车的弧度，恰好嵌在屯兵所生硬的线条里…缓和了严肃。——黛西",
    "Episode": 1210024,
    "Id": 1210024,
    "IsHide": false,
    "ListResources": "ui/textures/handbook_postcard/list_icons_notepostcard_yunshudongkou",
    "Name": "运输站的风车",
    "Resources": "ui/textures/handbook_postcard/notepostcard_image_yunshudongkou"
  },
  "1210025": {
    "DictionaryDes": "真是熟悉呢，运输站特有的泥土味和铁锈的味道。——黛西",
    "Episode": 1210025,
    "Id": 1210025,
    "IsHide": false,
    "ListResources": "ui/textures/handbook_postcard/list_icons_notepostcard_yunshucunzhuang",
    "Name": "铁轨旁的村庄",
    "Resources": "ui/textures/handbook_postcard/notepostcard_image_yunshucunzhuang"
  },
  "1210026": {
    "DictionaryDes": "这些丑陋的管道，通向我不愿知晓的秘密。——黛西",
    "Episode": 1210026,
    "Id": 1210026,
    "IsHide": false,
    "ListResources": "ui/textures/handbook_postcard/list_icons_notepostcard_yunshuyiqi",
    "Name": "运输站的钢铁巨兽",
    "Resources": "ui/textures/handbook_postcard/notepostcard_image_yunshuyiqi"
  },
  "1210027": {
    "DictionaryDes": "在下会永远铭记您的敦敦教训：「终此一生忠于使命」。 ——瑞德",
    "Episode": 1210027,
    "Id": 1210027,
    "IsHide": false,
    "ListResources": "ui/textures/handbook_postcard/list_icons_notepostcard_tunbingsuo",
    "Name": "屯兵所",
    "Resources": "ui/textures/handbook_postcard/notepostcard_image_tunbingsuo"
  },
  "1210028": {
    "DictionaryDes": "这里的特饮苦涩难咽，但有些任务，注定要喝一杯才行。 ——瑞德",
    "Episode": 1210028,
    "Id": 1210028,
    "IsHide": false,
    "ListResources": "ui/textures/handbook_postcard/list_icons_notepostcard_jiuguanshangceng",
    "Name": "山芥垆上层",
    "Resources": "ui/textures/handbook_postcard/notepostcard_image_jiuguanshangceng"
  },
  "1210029": {
    "DictionaryDes": "这些矿工虽然脏兮兮。可骨子里，他们的灵魂和我们一样。——瑞德",
    "Episode": 1210029,
    "Id": 1210029,
    "IsHide": false,
    "ListResources": "ui/textures/handbook_postcard/list_icons_notepostcard_jiuguanxiaceng",
    "Name": "山芥垆下层",
    "Resources": "ui/textures/handbook_postcard/notepostcard_image_jiuguanxiaceng"
  },
  "1210030": {
    "DictionaryDes": "每一处铆钉都像我的孩子，看到它们坚如磐石，夙愿得偿。——黛西",
    "Episode": 1210030,
    "Id": 1210030,
    "IsHide": false,
    "ListResources": "ui/textures/handbook_postcard/list_icons_notepostcard_yunshuxiaolu",
    "Name": "运输站一隅",
    "Resources": "ui/textures/handbook_postcard/notepostcard_image_yunshuxiaolu"
  },
  "1210031": {
    "DictionaryDes": "它每天都在拷问我的灵魂…为什么只有我一个人活下来。——布洛克",
    "Episode": 1210031,
    "Id": 1210031,
    "IsHide": false,
    "ListResources": "ui/textures/handbook_postcard/list_icons_notepostcard_huanhuanhua",
    "Name": "神悬御柱下的幻幻花",
    "Resources": "ui/textures/handbook_postcard/notepostcard_image_huanhuanhua"
  },
  "1210032": {
    "DictionaryDes": "这是我第一次看见地下的场景…如此辽阔，如此神秘。—— 亨特尔",
    "Episode": 1210032,
    "Id": 1210032,
    "IsHide": false,
    "ListResources": "ui/textures/handbook_postcard/list_icons_notepostcard_dixiafeiqikuangdong1",
    "Name": "愈合中的矿洞",
    "Resources": "ui/textures/handbook_postcard/notepostcard_image_dixiafeiqikuangdong1"
  },
  "1210033": {
    "DictionaryDes": "这些奇特的树枝让我充满期待，黑暗中定有特别的猎物。——亨特尔",
    "Episode": 1210033,
    "Id": 1210033,
    "IsHide": false,
    "ListResources": "ui/textures/handbook_postcard/list_icons_notepostcard_dixiafeiqikuangdong2",
    "Name": "遗忘，然后生长",
    "Resources": "ui/textures/handbook_postcard/notepostcard_image_dixiafeiqikuangdong2"
  },
  "1210034": {
    "DictionaryDes": "别误会…我只是出于商人的本能开始思考它的价值而已。——里奥",
    "Episode": 1210034,
    "Id": 1210034,
    "IsHide": false,
    "ListResources": "ui/textures/handbook_postcard/list_icons_notepostcard_dixiayihaokuangdong",
    "Name": "地下矿区的幻幻花",
    "Resources": "ui/textures/handbook_postcard/notepostcard_image_dixiayihaokuangdong"
  },
  "1210035": {
    "DictionaryDes": "明明就有娜宝！发财的好机会…为什么你们都看不见！？——里奥",
    "Episode": 1210035,
    "Id": 1210035,
    "IsHide": false,
    "ListResources": "ui/textures/handbook_postcard/list_icons_notepostcard_dixiayihaonabao",
    "Name": "幻妄之娜宝",
    "Resources": "ui/textures/handbook_postcard/notepostcard_image_dixiayihaonabao"
  },
  "1210036": {
    "DictionaryDes": "父亲说，红色的矿石拥有世界上最美丽的颜色。——艾琳",
    "Episode": 1210036,
    "Id": 1210036,
    "IsHide": false,
    "ListResources": "ui/textures/handbook_postcard/list_icons_notepostcard_dixiazhuanyun1",
    "Name": "转运区的铁轨",
    "Resources": "ui/textures/handbook_postcard/notepostcard_image_dixiazhuanyun1"
  },
  "1210037": {
    "DictionaryDes": "就是在这里，父亲离我而去…岩蛇带走了他的生命。——艾琳",
    "Episode": 1210037,
    "Id": 1210037,
    "IsHide": false,
    "ListResources": "ui/textures/handbook_postcard/list_icons_notepostcard_dixiazhuanyun2",
    "Name": "地下城邦",
    "Resources": "ui/textures/handbook_postcard/notepostcard_image_dixiazhuanyun2"
  },
  "1210038": {
    "DictionaryDes": "一辈子与矿石打交道的工匠，终于见到了它们的出生地。——布鲁克",
    "Episode": 1210038,
    "Id": 1210038,
    "IsHide": false,
    "ListResources": "ui/textures/handbook_postcard/list_icons_notepostcard_dixiacaijue",
    "Name": "深层采掘区",
    "Resources": "ui/textures/handbook_postcard/notepostcard_image_dixiacaijue"
  },
  "1210039": {
    "DictionaryDes": "……这种从未接触过的神秘矿石，感觉能做很多东西呢！——布鲁克",
    "Episode": 1210039,
    "Id": 1210039,
    "IsHide": false,
    "ListResources": "ui/textures/handbook_postcard/list_icons_notepostcard_dixiashuijing",
    "Name": "晶石贮存地",
    "Resources": "ui/textures/handbook_postcard/notepostcard_image_dixiashuijing"
  },
  "1210040": {
    "DictionaryDes": "自然正在回归…过度开采的伤痕终将被抚平。——费林克斯",
    "Episode": 1210040,
    "Id": 1210040,
    "IsHide": false,
    "ListResources": "ui/textures/handbook_postcard/list_icons_notepostcard_dixiakuangqu1",
    "Name": "自然的回归",
    "Resources": "ui/textures/handbook_postcard/notepostcard_image_dixiakuangqu1"
  },
  "1210041": {
    "DictionaryDes": "有些真相注定要深埋。就像这个矿洞，永远缄默。——费林克斯",
    "Episode": 1210041,
    "Id": 1210041,
    "IsHide": false,
    "ListResources": "ui/textures/handbook_postcard/list_icons_notepostcard_dixiakuangqu2",
    "Name": "缄默之地",
    "Resources": "ui/textures/handbook_postcard/notepostcard_image_dixiakuangqu2"
  },
  "1210100": {
    "DictionaryDes": "「此路尽头，皆是同袍。」<br>愿白狼的胸怀包容你的锋芒，如万川归海。<br><align=\"right\">· 秋祭司 森塔拉 ·",
    "Episode": 1210100,
    "Id": 1210100,
    "IsHide": false,
    "ListResources": "ui/textures/handbook_postcard/list_icons_notepostcard_kaniman_kanimanbuluo",
    "Name": "狼图腾息壤",
    "Resources": "ui/textures/handbook_postcard/notepostcard_image_kaniman_kanimanbuluo"
  },
  "1210101": {
    "DictionaryDes": "「当年族人被战火牵连时，蛇图腾的族人是第一个站出来反抗的。」<br>「就像这次飓风中，你为我们做的那样。」<br><br>蛇的信子将为你探明暗礁，每逢战斗，如利齿贯甲。<br><align=\"right\">· 酋长 罗特罗亚尼 ·",
    "Episode": 1210101,
    "Id": 1210101,
    "IsHide": false,
    "ListResources": "ui/textures/handbook_postcard/list_icons_notepostcard_kaniman_kanimanjiuzhi",
    "Name": "蛇图腾息壤",
    "Resources": "ui/textures/handbook_postcard/notepostcard_image_kaniman_kanimanjiuzhi"
  },
  "1210102": {
    "DictionaryDes": "「空气之于飞鸟，欢笑之于生活。」<br>愿前路险阻，皆化作跃向星辰的踏石。<br><align=\"right\">· 春祭司 索奇特尔 ·",
    "Episode": 1210102,
    "Id": 1210102,
    "IsHide": false,
    "ListResources": "ui/textures/handbook_postcard/list_icons_notepostcard_kaniman_dengluzhanyizhi",
    "Name": "鸟图腾息壤",
    "Resources": "ui/textures/handbook_postcard/notepostcard_image_kaniman_dengluzhanyizhi"
