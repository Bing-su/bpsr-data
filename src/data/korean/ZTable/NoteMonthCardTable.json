{
  "9070001": {
    "DictionaryDes": "11월. 겨울이 살포시 다가오는 계절. 세월의 깊은 곳에서 사랑과 빛을 찾으며 고요하고 따스하게 살아간다.",
    "Episode": 9070001,
    "Id": 9070001,
    "IsHide": false,
    "ListResources": "ui/textures/handbook_month_card/monthly_reward_card_main_card_02",
    "Name": "2025년 11월 컬렉션 카드",
    "Resources": "ui/textures/handbook_month_card/monthly_reward_card_02"
  },
  "9070002": {
    "DictionaryDes": "겨울 햇살이 부드럽게 내리쬔다. 한 줄기 한 줄기 빛은 마치 시간의 붓결처럼 고요히 평온한 세월을 그린다.",
    "Episode": 9070002,
    "Id": 9070002,
    "IsHide": false,
    "ListResources": "ui/textures/handbook_month_card/monthly_reward_card_main_card_03",
    "Name": "2025년 12월 컬렉션 카드",
    "Resources": "ui/textures/handbook_month_card/monthly_reward_card_03"
  },
  "9070003": {
    "DictionaryDes": "아직 추위가 느껴지는 1월. 새해를 향한 무한한 기대와 설렘이 가득하다...",
    "Episode": 9070003,
    "Id": 9070003,
    "IsHide": false,
    "ListResources": "ui/textures/handbook_month_card/monthly_reward_card_main_card_04",
    "Name": "2026년 1월 컬렉션 카드",
    "Resources": "ui/textures/handbook_month_card/monthly_reward_card_04"
  },
  "9070004": {
    "DictionaryDes": "2월. 화사한 꽃향기 속에서 진주 커튼과 화려한 창문이 반짝인다...",
    "Episode": 9070004,
    "Id": 9070004,
    "IsHide": false,
    "ListResources": "ui/textures/handbook_month_card/monthly_reward_card_main_card_05",
    "Name": "2026년 2월 컬렉션 카드",
    "Resources": "ui/textures/handbook_month_card/monthly_reward_card_05"
  },
  "9070005": {
    "DictionaryDes": "꽃다발이 만발한 3월은 한 폭의 시와도 같습니다.",
    "Episode": 9070005,
    "Id": 9070005,
    "IsHide": false,
    "ListResources": "ui/textures/handbook_month_card/monthly_reward_card_main_card_06",
    "Name": "2026년 3월 컬렉션 카드",
    "Resources": "ui/textures/handbook_month_card/monthly_reward_card_06"
  },
  "9070006": {
    "DictionaryDes": "봄기운이 점점 짙어지니, 마음을 움직이는 여름날 그림이 서서히 펼쳐지는 듯합니다.",
    "Episode": 9070006,
    "Id": 9070006,
    "IsHide": false,
    "ListResources": "ui/textures/handbook_month_card/monthly_reward_card_main_card_07",
    "Name": "2026년 4월 컬렉션 카드",
    "Resources": "ui/textures/handbook_month_card/monthly_reward_card_07"
  },
  "9070007": {
    "DictionaryDes": "매미 소리가 울려 퍼지고, 5월이 찾아옵니다. 두견새의 맑은 울음소리가 들판에 가득 메아리치고, 실처럼 가느다란 빗줄기가 가만히 떨어집니다.",
    "Episode": 9070007,
    "Id": 9070007,
    "IsHide": false,
    "ListResources": "ui/textures/handbook_month_card/monthly_reward_card_main_card_08",
    "Name": "2026년 5월 컬렉션 카드",
    "Resources": "ui/textures/handbook_month_card/monthly_reward_card_08"
  },
  "9070008": {
    "DictionaryDes": "6월은 뜨거운 여름의 서곡. 맑은 하늘은 한 점의 망설임도 없이 푸르기만 하다.",
    "Episode": 9070008,
    "Id": 9070008,
    "IsHide": false,
    "ListResources": "ui/textures/handbook_month_card/monthly_reward_card_main_card_09",
    "Name": "2026년 6월 컬렉션 카드",
    "Resources": "ui/textures/handbook_month_card/monthly_reward_card_09"
  },
  "9070009": {
    "DictionaryDes": "끝없이 늘어선 연꽃, 풀과 나무가 무성한 가운데, 7월의 세상은 아름다움과 재회한다.",
    "Episode": 9070009,
    "Id": 9070009,
    "IsHide": false,
    "ListResources": "ui/textures/handbook_month_card/monthly_reward_card_main_card_10",
    "Name": "2026년 7월 컬렉션 카드",
    "Resources": "ui/textures/handbook_month_card/monthly_reward_card_10"
  },
  "9070010": {
    "DictionaryDes": "8월. 별이 시선을 내리고, 달이 사랑에 빠진다. 8월은 바람과 연기가 사라지고, 세상의 온기를 맛보는 달이다.",
    "Episode": 9070010,
    "Id": 9070010,
    "IsHide": false,
    "ListResources": "ui/textures/handbook_month_card/monthly_reward_card_main_card_11",
